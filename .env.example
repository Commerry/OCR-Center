# OCR Center configuration
PORT=8090

# API key devices must send in X-Api-Key header (blank = accept all)
API_KEY=

# Dashboard name shown in the header, login page and browser tab
SITE_NAME=OCR CENTER
SITE_SUBTITLE=STA-SK Fleet Monitor

# Dashboard login (blank DASH_USER = no login required)
DASH_USER=
DASH_PASS=

# Device considered offline after this many seconds without a heartbeat
OFFLINE_AFTER_SEC=90

# Report / images
# how many days of read images to keep on the center (0 = keep forever)
IMAGES_KEEP_DAYS=30
# hard size cap for the image store, MB (0 = no cap).
# When passed, the oldest day folders are deleted first - images can never
# fill the disk, whatever IMAGES_KEEP_DAYS says.
IMAGES_MAX_MB=20000
# stop writing new images while the drive has less free space than this (%)
IMAGES_MIN_FREE_PERCENT=15
# which reads deserve a stored image: all | failed | smart
#   all    = every read (most retraining data, most disk)
#   failed = only 888 / 999
#   smart  = failed + low confidence + a sample of the good reads
IMAGE_STORE_MODE=all
# used by smart mode only
IMAGE_LOW_CONF_PERCENT=90
IMAGE_SAMPLE_PERCENT=5
# where images live (blank = data/images next to the program).
# Point it at another drive to keep them off the system disk.
IMAGES_DIR=
# timezone used for report timestamps and image folders
REPORT_TZ=Asia/Bangkok

# Data retention
READS_KEEP_DAYS=90
HEALTH_KEEP_DAYS=14
